# ============================================================
# ComCare - Environment variable reference
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Environment Mode ---
DJANGO_ENV=development

# --- Core Django ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- CORS & Security ---
# Comma-separated list of allowed frontend origins (e.g. Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated HTTPS origins allowed to POST with CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SimpleJWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Database (production: Postgres/Neon e.g., postgres://user:pass@ep-host.region.aws.neon.tech/dbname?sslmode=require) ---
# Local dev may omit this; SQLite is used automatically when DEBUG=True.
DATABASE_URL=
DJANGO_CONN_MAX_AGE=0

# --- HTTPS / cookies (production recommended values) ---
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@comcare.local

# --- Razorpay ---
# Use TEST keys in development, LIVE keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=